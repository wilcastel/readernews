# Configuración del Sistema MCP Git Workflow
# Este archivo contiene todas las variables de configuración del sistema

# Configuración de ramas Git
MCP_GIT_DEVELOP_BRANCH=develop
MCP_GIT_TRYCODE_BRANCH=trycode
MCP_GIT_REMOTE_NAME=origin

# Configuración del servidor de pruebas
MCP_GIT_SERVER_URL=https://readernews.test

# Configuración de revisión por líder
MCP_GIT_REVIEW_REQUIRED_ASK=true
MCP_GIT_NOTIFY_LEADER=true
MCP_GIT_LEADER_EMAIL=lider@empresa.com

# Configuración de seguridad y comportamiento
MCP_GIT_TRYCODE_PRESERVE=true
MCP_GIT_CONFIRM_OVERWRITE=true
MCP_GIT_LOG_LEVEL=normal
MCP_GIT_ERROR_DETECTION=all

# Configuración de colores y estilo
MCP_COLOR_ENABLED=true

# Configuración de timeouts
MCP_GIT_PUSH_TIMEOUT=120
MCP_GIT_MERGE_TIMEOUT=300

# Configuración de notificaciones
MCP_NOTIFICATIONS_ENABLED=true
MCP_NOTIFICATION_EMAIL=true
MCP_NOTIFICATION_SLACK=false